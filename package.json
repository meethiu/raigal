{
	"name": "@methiu/raigal",
	"version": "0.16.3",
	"publishConfig": {
		"access": "public"
	},
	"description": "Catch the slop AI coding agents leave in your code: narrative comments, swallowed exceptions, as-any casts, dead code, oversized functions. 50+ rules across 10 language targets (TypeScript, JavaScript, Expo / React Native, Python, Go, Rust, Ruby, PHP, C#, C/C++). Sub-second, deterministic, no LLM at runtime.",
	"type": "module",
	"bin": {
		"raigal": "dist/cli.js",
		"raigal-mcp": "dist/mcp.js",
		"raigal-tools": "scripts/install-tools.mjs"
	},
	"files": [
		"dist",
		"scripts",
		"tools/jb"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./adapters/astro": {
			"types": "./dist/adapters/astro.d.ts",
			"default": "./dist/adapters/astro.js"
		},
		"./adapters/expo": {
			"types": "./dist/adapters/expo.d.ts",
			"default": "./dist/adapters/expo.js"
		},
		"./adapters/nuxt": {
			"types": "./dist/adapters/nuxt.d.ts",
			"default": "./dist/adapters/nuxt.js"
		},
		"./adapters/sveltekit": {
			"types": "./dist/adapters/sveltekit.d.ts",
			"default": "./dist/adapters/sveltekit.js"
		},
		"./adapters/vite": {
			"types": "./dist/adapters/vite.d.ts",
			"default": "./dist/adapters/vite.js"
		}
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "node --require ./scripts/polyfill.cjs ./node_modules/tsdown/dist/run.mjs",
		"typecheck": "tsc --noEmit",
		"gen:schema": "pnpm build && node scripts/gen-config-schema.mjs",
		"test": "pnpm build && vitest run",
		"scan": "pnpm build && node dist/cli.js scan .",
		"scan:exclude": "pnpm build && node dist/cli.js scan . --exclude .idea --exclude .gitnore --exclude node_modules",
		"scan:include": "pnpm build && node dist/cli.js scan . --include src --include tests",
		"scan:json": "pnpm build && node dist/cli.js scan . --json",
		"check:licenses": "node scripts/check-licenses.mjs",
		"check:tarball-keys": "node scripts/check-tarball-keys.mjs",
		"release:guard": "node scripts/release-guard.mjs",
		"quality": "pnpm typecheck && pnpm test && node scripts/check-tarball-keys.mjs && node dist/cli.js scan . --json"
	},
	"keywords": [
		"raigal",
		"ai-slop",
		"code-quality",
		"linter",
		"formatter",
		"cli",
		"ai",
		"copilot",
		"code-review",
		"static-analysis",
		"typescript",
		"javascript",
		"python",
		"go",
		"rust",
		"ruby",
		"php",
		"csharp",
		"dotnet",
		"cpp"
	],
	"author": {
		"name": "Kenny Olawuwo",
		"url": "https://raigal.dev"
	},
	"license": "SEE LICENSE IN LICENSE",
	"homepage": "https://raigal.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meethiu/raigal.git"
	},
	"bugs": {
		"url": "https://github.com/meethiu/raigal/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.28.0",
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"@clack/prompts": "^1.7.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"adm-zip": "^0.6.1",
		"commander": "^14.0.3",
		"expo-doctor": "^1.20.4",
		"ink": "^7.1.1",
		"ink-select-input": "^6.2.0",
		"knip": "^6.34.0",
		"micromatch": "^4.0.8",
		"oxlint": "^1.81.0",
		"picocolors": "^1.1.1",
		"react": "^19.2.8",
		"smol-toml": "^1.8.0",
		"tar": "^7.5.22",
		"typescript": "^6.0.3",
		"wcwidth": "^1.0.1",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/micromatch": "^4.0.10",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"ink-testing-library": "^4.0.0",
		"tsdown": "^0.22.14",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
